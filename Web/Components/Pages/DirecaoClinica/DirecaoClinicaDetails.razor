@page "/Estabelecimentos/{EstabelecimentoId:long}/DirecaoClinica"
@page "/Estabelecimentos/{EstabelecimentoId:long}/DirecaoClinica/{DirecaoClinicaId:long}"
@rendermode InteractiveServer
@using SharedKernel.DTO
@using MudBlazor

<PageTitle>Direção Clínica</PageTitle>
<MudPaper Class="pa-6">
    <MudText Typo="Typo.h5" Class="mb-4">Diretor Clínico / Responsável Técnico</MudText>
    @if (DirecaoClinica == null)
    {
        <MudProgressCircular Indeterminate Color="Color.Primary" />
        <MudText Class="mt-2">Carregando...</MudText>
    }
    else
    {
        <MudForm @ref="mudForm">
            <MudGrid GutterSize="3">
                <MudItem xs="12" md="6">
                    <MudTextField Label="Nome" @bind-Value="DirecaoClinica.Nome" For="@(() => DirecaoClinica.Nome)"
                        Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField Label="Identificação" @bind-Value="DirecaoClinica.Identificacao"
                        For="@(() => DirecaoClinica.Identificacao)" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker Label="Validade Identificação" @bind-Date="DirecaoClinica.ValidadeIdentificacao" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField Label="Cargo" @bind-Value="DirecaoClinica.Cargo" For="@(() => DirecaoClinica.Cargo)" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField Label="Cédula Profissional" @bind-Value="DirecaoClinica.Cedula"
                        For="@(() => DirecaoClinica.Cedula)" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField Label="Associação Profissional/Ordem" @bind-Value="DirecaoClinica.Ordem"
                        For="@(() => DirecaoClinica.Ordem)" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string" Label="Tipologia" @bind-Value="DirecaoClinica.Tipologia"
                        SearchFunc="TipologiasDataProvider" ToStringFunc="@(t => t)" Clearable="true"
                        Placeholder="Pesquisar tipologia..." ValueChanged="OnTipologiaChanged" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="Observações" @bind-Value="DirecaoClinica.Observacoes"
                        For="@(() => DirecaoClinica.Observacoes)" />
                </MudItem>
            </MudGrid>
            <MudDivider Class="my-4" />
            <MudStack Direction="Row" Spacing="2">
                <MudButton Variant="Filled" Color="Color.Primary" OnClick="SaveDirecaoClinica">Guardar</MudButton>
                <MudButton Variant="Outlined" Color="Color.Primary" OnClick="GoBackToEstabelecimento">Voltar</MudButton>
            </MudStack>
            <SaveBackControl OnClickSaveEventHandler="SaveDirecaoClinica"
                OnClickBackEventHandler="GoBackToEstabelecimento" />
        </MudForm>
    }
</MudPaper>
